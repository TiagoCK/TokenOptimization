__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
build/
dist/

# Local clutter that should never reach the repository.
.DS_Store
node_modules/

# Never commit a real customer export. The whole premise of this tool is that
# the data stays on the machine that produced it.
*.csv
!tests/fixtures/**/*.csv
# The two exceptions are generated, not collected: tests/_sample.py writes them
# from invented numbers, and `python -m tests.generate_sample` reproduces them
# byte for byte. Keep this pattern narrow -- it is the one hole in the rule.
!examples/sample-usage.csv
!examples/sample-cost.csv
