      "claude-opus-4-7",
      "claude-opus-4-6",
      "claude-sonnet-5",
      "claude-sonnet-4-6"
    ]
  },

  "model_tiers": {
    "provenance": "classification",
    "note": "The 'tier' on each model below (frontier / mid / small) is this tool's classification, not Anthropic's -- the pricing page publishes rates, not tiers. It is used only to group the model-mix observation (C8) and never affects a price. Edit it to match how your organization thinks about its models."
  },

  "server_tools": {
    "web_search": {
      "usd_per_1000_requests": "10",
      "provenance": "published",
      "note": "'Web search is available on the Claude API for $10 per 1,000 searches, plus standard token costs.' Countable from usage via server_tool_use.web_search_requests."
    },
    "code_execution": {
      "usd_per_container_hour": "0.05",
      "free_hours_per_month": "1550",
      "provenance": "published",
      "priceable_from_usage": false,
      "note": "Billed by execution time, not tokens, with a 5-minute minimum per container. Appears only in the cost endpoint under cost_type 'code_execution'. Cannot be estimated from usage data. Free when used alongside web_search_20260209+ or web_fetch_20260209+."
    },
    "session_usage": {
      "usd_per_session_hour": "0.08",
      "provenance": "published",
      "priceable_from_usage": false,
      "note": "Claude Managed Agents session runtime, accrued only while a session is 'running'. Appears only in the cost endpoint under cost_type 'session_usage'."
    }
  },

