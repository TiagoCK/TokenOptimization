  "currency": "USD",
  "unit": "usd_per_million_tokens",

  "_readme": [
    "Every dollar figure this tool prints traces back to this file. Nothing is",
    "inferred at runtime and nothing is hardcoded in check logic.",
    "",
    "Each rate carries a 'provenance' entry saying where the number came from:",
    "  'published'  - transcribed verbatim from the pricing page table",
    "  'derived: X' - computed from other published values by the stated rule.",
    "                 tests/test_pricing_provenance.py re-derives every one of",
    "                 these and fails if the arithmetic drifts.",
    "",
    "If a rate here is wrong for your organization (negotiated pricing, volume",
    "discount, enterprise terms), edit this file. The numbers in the report will",
    "change accordingly. That is the intended workflow."
  ],

  "multipliers": {
    "cache_write_5m": {
      "value": "1.25",
      "of": "uncached_input",
      "provenance": "published",
      "note": "Prompt caching table: '5-minute cache write: 1.25x base input price'"
    },
    "cache_write_1h": {
      "value": "2",
      "of": "uncached_input",
      "provenance": "published",
      "note": "Prompt caching table: '1-hour cache write: 2x base input price'"
    },
    "cache_read": {
      "value": "0.1",
      "of": "uncached_input",
      "provenance": "published",
      "note": "Prompt caching table: 'Cache read (hit): 0.1x base input price (0.025x on Claude Fable 5.1 and Claude Mythos 5.1)'. Per-model rates below are authoritative; this multiplier exists for provenance checking only."
    }
  },

  "service_tier_multipliers": {
    "standard": {
      "value": "1",
      "provenance": "published",
      "note": "Baseline. The model pricing table is standard-tier pricing."
    },
    "batch": {
      "value": "0.5",
      "provenance": "published",
      "note": "'The Batch API allows asynchronous processing of large volumes of requests with a 50% discount on both input and output tokens.' Verified against the published batch table: Opus 5 $2.50/$12.50 = 0.5 x $5/$25."
    }
  },

  "unpriced_service_tiers": {
    "flex": "No published rate. Not present in the cost endpoint's service_tier enum (batch|standard|null).",
    "flex_discount": "No published rate. Not present in the cost endpoint's service_tier enum.",
    "priority": "Priority Tier uses a different billing model and is excluded from the cost endpoint entirely. The report raises a loud warning rather than a silently wrong total.",
    "priority_on_demand": "No published rate. Not present in the cost endpoint's service_tier enum."
  },

  "inference_geo_multipliers": {
    "global": {
      "value": "1",
      "provenance": "published",
      "note": "'Global routing (the default) uses standard pricing.'"
    },
    "us": {
      "value": "1.1",
      "provenance": "published",
      "note": "'specifying US-only inference through the inference_geo parameter incurs a 1.1x multiplier on all token pricing categories, including input tokens, output tokens, cache writes, and cache reads.' Claude 4.6+ only."
    },
    "not_available": {
      "value": "1",
      "provenance": "published",
      "note": "Models predating Feb 2026 do not support inference_geo and always use standard pricing."
    }
  },

  "long_context": {
    "provenance": "published",
    "note": "'Claude 4.6 and later models and Claude Mythos Preview include the full 1M token context window at standard pricing. (A 900k-token request is billed at the same per-token rate as a 9k-token request.)' The page makes no statement about long-context rates for earlier models, so their 200k-1M traffic is priced at the standard rate below and reported as unconfirmed rather than assumed correct.",
    "standard_rate_models": [
      "claude-fable-5-1",
      "claude-mythos-5-1",
      "claude-fable-5",
      "claude-mythos-5",
